# Raw ISA inputs live on the external drive (paths in config/config.yml).
# Never commit copies: a truncated 130 MB partial was once swept in by `git add -A`.
*.Rdata
*.RData
*_Unfiltered_*/

# Reference annotation and transcript FASTAs copied in from the external drive.
# gff3/ is 1.1 GB and fa/ is 2.8 GB — same reason as above, never commit these.
gff3/
fa/
*.gff3
*.gtf
*.fa
*.fasta

# R
.Rhistory
.RData
.Ruserdata
*.Rproj.user
*.rds~
# renv
renv/local/
# outputs (optional: uncomment to track some results; default ignore large/binary)
# results/figures/*
# data/raw/*.rds

# Python / Jupyter
.venv
__pycache__/
*.ipynb_checkpoints
.pytest_cache

# OS / editor
.DS_Store
*.swp
.quarto/

# Quarto
*_files/

/.quarto/
**/*.quarto_ipynb

# Large regenerable intermediates. 23 writes a per-isoform table for every fitted model,
# which is ~13 MB and nothing reads it: the figures and explore/23_refit_dual_anchor_explore.R
# work from the summary CSVs, and it regenerates by re-running the script. It was committed
# once and made the push pack 33 MB; keep it local.
results/tables/refit_isoform_level.rds

# Default R graphics output. Writing it is a side effect of running any explore/ script from
# the repo root without a device open, and it is NOT a result worth versioning. NOTE: this
# entry is inert until the file is untracked, which is deliberately left to you:
#   git rm --cached Rplots.pdf
/Rplots.pdf
